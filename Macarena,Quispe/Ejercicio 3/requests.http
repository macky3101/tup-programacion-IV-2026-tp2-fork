@baseUrl = http://localhost:3000

### Listar alumnos
GET {{baseUrl}}/alumnos

### Crear un alumno
POST {{baseUrl}}/alumnos
Content-Type: application/json

{
  "nombre": "Ana Perez"
}

### Listar materias
GET {{baseUrl}}/materias

### Crear una materia
POST {{baseUrl}}/materias
Content-Type: application/json

{
  "nombre": "Programacion IV"
}

### Listar calificaciones
GET {{baseUrl}}/calificaciones

### Obtener una calificacion
GET {{baseUrl}}/calificaciones/1

### Crear una calificacion
POST {{baseUrl}}/calificaciones
Content-Type: application/json

{
  "alumnoId": 1,
  "materiaId": 1,
  "notas": [8, 9, 10]
}

### Actualizar una calificacion
PUT {{baseUrl}}/calificaciones/1
Content-Type: application/json

{
  "alumnoId": 1,
  "materiaId": 1,
  "notas": [7, 8, 9]
}

### Eliminar una calificacion
DELETE {{baseUrl}}/calificaciones/1